# Neon Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# Twilio SMS (optional — for morning briefing + reply-to-complete)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Or use API key auth instead of AUTH_TOKEN:
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=+1...
MY_PHONE_NUMBER=+1...

# Vercel Cron
CRON_SECRET=
